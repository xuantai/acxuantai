{
  "entities": {
    "SocialStats": {
      "title": "SocialStats",
      "description": "Social media follower counts and statistics",
      "type": "object",
      "properties": {
        "facebook": {
          "type": "integer",
          "description": "Facebook followers count"
        },
        "tiktok": {
          "type": "integer",
          "description": "TikTok followers count"
        },
        "youtube": {
          "type": "integer",
          "description": "YouTube subscribers count"
        },
        "lastUpdate": {
          "type": "integer",
          "format": "timestamp",
          "description": "Timestamp of the last update in milliseconds"
        }
      },
      "required": [
        "facebook",
        "tiktok",
        "youtube",
        "lastUpdate"
      ]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Admin configuration containing website branding, bio, and social info",
      "type": "object",
      "properties": {
        "websiteTitle": { "type": "string" },
        "artistName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "logoWhiteUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "bio1": { "type": "string" },
        "bio2": { "type": "string" },
        "writeToken": { "type": "string" }
      }
    }
  },
  "firestore": {
    "social_stats": {
      "schema": "SocialStats",
      "description": "Historical and current recordings of social media follower counts"
    },
    "configs": {
      "schema": "AdminConfig",
      "description": "Branding and customized static info for the website"
    }
  }
}
